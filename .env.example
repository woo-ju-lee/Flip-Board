# Disabled until collection permission and the outbound network rule are verified.
KORAIL_LIVE_ENABLED=false
# Record a genuine permission/terms reference here before enabling collection.
KORAIL_USAGE_POLICY_REFERENCE=
KORAIL_POLL_SECONDS=60
KORAIL_TIMEOUT_SECONDS=15
KORAIL_STALE_SECONDS=150
KORAIL_MAX_BACKOFF_SECONDS=900
KORAIL_MATCH_DISTANCE_METERS=70
KORAIL_AMBIGUITY_METERS=35
KORAIL_MIN_CONFIDENCE=0.65
KORAIL_SWITCH_CONFIRMATIONS=2
KORAIL_MAX_SPEED_METERS_PER_SECOND=120
# Optional absolute directory containing catalog.json and segments.geojson
# KORAIL_DATA_DIR=/absolute/path/to/reviewed-data
# Run ONE backend worker: cache/poll coordination is deliberately in memory.
